diff --git a/ggml/src/ggml-cuda/mmq-load-tiles.cuh b/ggml/src/ggml-cuda/mmq-load-tiles.cuh
index 7f00bad94..bb61a5d75 100644
--- a/ggml/src/ggml-cuda/mmq-load-tiles.cuh
+++ b/ggml/src/ggml-cuda/mmq-load-tiles.cuh
@@ -1224,6 +1224,79 @@ template <ggml_type type, int J, bool fallback> static __device__ __forceinline_
     }
 }
 
+// IQ1_M: a weight is d16 * (g - 1 +- 1/8), g in {0, 1, 2} from the IQ1_S grid and d16 = d * (2 s + 1) per 16 values.
+// Times 8 that is d16/8 * (8 g - 8 +- 1), an int8 in {-9, -7, -1, 1, 7, 9}: the tile holds the weights exactly, in
+// IQ2_XS's layout (int8 values, a float scale per 16 values: the q8_0_16 dot products).
+template <ggml_type type, int J, bool fallback> static __device__ __forceinline__ void ggml_cuda_mmq_load_tiles_iq1_m(
+        const char * __restrict__ x, int * __restrict__ x_tile, const int kbx0, const int i_max, const int stride) {
+    constexpr int warp_size   = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps      = ggml_cuda_mmq_get_nthreads(type, J, fallback) / warp_size;
+    constexpr int I           = ggml_cuda_mmq_get_I(type, J, fallback);
+    constexpr int sram_stride = ggml_cuda_mmq_get_sram_stride(type, J, fallback);
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_qs + MMQ_TILE_NE_K*2);
+#else
+    constexpr tile_x_sizes txs = mmq_get_dp4a_tile_x_sizes(GGML_TYPE_IQ1_M, I);
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_qs + txs.qs);
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+
+    // a thread takes one 32-value sub-block: 4 groups of 8 values, each an 11-bit grid index and its shift's sign
+    constexpr int threads_per_row = MMQ_ITER_K / 32;
+    constexpr int nrows = warp_size / threads_per_row;
+    const int kqsx = threadIdx.x % threads_per_row;
+
+#pragma unroll
+    for (int i0 = 0; i0 < I; i0 += nwarps * nrows) {
+        int i = i0 + threadIdx.y*nrows + threadIdx.x/threads_per_row;
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const block_iq1_m * bxi = (const block_iq1_m *) x + kbx0 + i*stride;
+
+        const int       qs_packed = get_int_b2(bxi->qs, kqsx);
+        const uint8_t * qs        = (const uint8_t *) &qs_packed;
+        const int       qh        = bxi->qh[2*kqsx] | (bxi->qh[2*kqsx + 1] << 8);   // group l: bits 4l .. 4l+3
+
+    #pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int qhl  = qh >> (4*l);
+            const int grid = iq1s_grid_gpu[qs[l] | ((qhl & 0x07) << 8)];
+            const int k    = (qhl & 0x08) ? 0x09090909 : 0x07070707;   // 8 * (1 +- 1/8)
+
+            const int grid0 = __vsub4(((grid >> 0) & 0x0F0F0F0F) << 3, k);
+            const int grid1 = __vsub4(((grid >> 4) & 0x0F0F0F0F) << 3, k);
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+            x_qs[i*sram_stride + 8*kqsx + (2*l + 0)] = grid0;
+            x_qs[i*sram_stride + 8*kqsx + (2*l + 1)] = grid1;
+#else
+            x_qs[i*(2*MMQ_TILE_NE_K + 1) + 8*kqsx + (2*l + 0)] = grid0;
+            x_qs[i*(2*MMQ_TILE_NE_K + 1) + 8*kqsx + (2*l + 1)] = grid1;
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        }
+
+        // the block's fp16 scale in the top nibbles of its four 16-bit scale words; the sub-block's 16-value halves
+        // are 3-bit scales 2 kqsx and 2 kqsx + 1
+        const uint16_t * sc = (const uint16_t *) bxi->scales;
+        iq1m_scale_t scale;
+        scale.u16 = (sc[0] >> 12) | ((sc[1] >> 8) & 0x00f0) | ((sc[2] >> 4) & 0x0f00) | (sc[3] & 0xf000);
+        const float d  = __half2float(scale.f16) * 0.125f;
+        const int   sw = sc[kqsx/2] >> (6*(kqsx % 2));
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        x_df[i*sram_stride                             + 2*kqsx+0] = d * (2*((sw >> 0) & 0x07) + 1);
+        x_df[i*sram_stride                             + 2*kqsx+1] = d * (2*((sw >> 3) & 0x07) + 1);
+#else
+        x_df[i*(2*MMQ_TILE_NE_K*2/QI8_0) + i/(QI8_0/4) + 2*kqsx+0] = d * (2*((sw >> 0) & 0x07) + 1);
+        x_df[i*(2*MMQ_TILE_NE_K*2/QI8_0) + i/(QI8_0/4) + 2*kqsx+1] = d * (2*((sw >> 3) & 0x07) + 1);
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    }
+}
